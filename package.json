{
  "name": "@getverdict/mock-bridge",
  "version": "1.3.1",
  "description": "Mock Shopify App Bridge for testing and development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./client": {
      "types": "./dist/client/mock-detector.d.ts",
      "default": "./dist/client/mock-detector.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "bin": {
    "mock-bridge": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:admin-frame && npm run build:app-bridge",
    "build:admin-frame": "cd admin-frame && npm run build",
    "build:app-bridge": "cd app-bridge && npm run build",
    "dev": "concurrently \"ts-node -r dotenv/config src/server/dev.ts\" \"npm run dev:app-bridge\" \"npm run dev:admin-frame\"",
    "dev:app-bridge": "cd app-bridge && npm run watch",
    "dev:admin-frame": "cd admin-frame && npm run dev",
    "start": "node dist/server/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "cd admin-frame && npm install --legacy-peer-deps && cd ../app-bridge && npm install && cd .. && npm run build"
  },
  "keywords": [
    "shopify",
    "app-bridge",
    "mock",
    "testing",
    "development"
  ],
  "author": "Verdict",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bevycommerce/mock-bridge.git"
  },
  "peerDependencies": {
    "@shopify/shopify-api": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "@shopify/shopify-app-react-router": "^1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router": "^7.6.2"
  },
  "peerDependenciesMeta": {
    "@shopify/shopify-api": {
      "optional": true
    },
    "@shopify/shopify-app-react-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/react": "^19.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "assets/",
    "admin-frame/dist/",
    "app-bridge/dist/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
