{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shopify/shopify-app-react-router/server": [
        "./node_modules/@shopify/shopify-app-react-router/dist/ts/server/index.d.ts"
      ],
      "@shopify/shopify-app-react-router/react": [
        "./node_modules/@shopify/shopify-app-react-router/dist/ts/react/index.d.ts"
      ],
      "@shopify/shopify-api/adapters/web-api": [
        "./node_modules/@shopify/shopify-api/dist/ts/adapters/web-api/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}